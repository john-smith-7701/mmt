% layout 'default';
% title 'AST DEMO';
<style>
  body {
   background-color: #f6f8fa;
   color: black;
  }
  h1 {
   background-color: #2da44e;
  }
  button {
   background-color: #24292f;
  }
  #file_name {
    margin-left: 0.5rem;
    font-size: 0.9rem;
    color: #666;
  }
  #anser {
    color: #606060;
  }
  .flex{
      display: flex;
      flex-wrap: wrap;
  }
  .menucel{
      width: 40em;
  }
</style>
 <h1>AST</h1>
これはDSLのASTを学ぶためのデモページです。
%= form_for ast => (method => 'post', enctype => 'multipart/form-data') => begin
 計算式ファイルのアップロード： 
%= file_field 'source_file', id => 'source_file'
 <span id="file_name"></span>
 <div class="flex">
  <div class="menucel">
  <br>スクリプト:
  %= text_area 'calc', rows => 20, cols => 80, id => 'calc', placeholder => "1 + 2 * 3; \n\ngcd(a,b) = b?gcd(b,a % b):a;\ngcd(72,30);"
  </div>
  <div class="menucel">
  %= submit_button '実行' ,id=>'run'
  %= check_box 'debg', id=>'debg'
  %= label_for 'debg' =>'ASTを表示'
  %= check_box 'out' =>'json'
  %= label_for 'out' =>'JSON出力'
  </div>
 </div>
% end
<div id=anser>
 <%= stash('anser') %>
 <hr>[AST Tree Area]<pre>
 <div id="tree">
 <%== stash('tree') %>
 </div>
</pre>
</div>
<div id=sample>
<hr>
<h4>example DSL</h4>
  <ul>
    <li><a onclick="calc.value='1+2*3';run.click();">四則演算</a></li>
    <li><a onclick="calc.value='gcd(a,b) = b?gcd(b,a % b):a;\ngcd(72,30);';run.click();">最大公約数</a></li>
    <li><a onclick="calc.value='gcd(a,b) = b?gcd(b,a % b):a;\nlcm(a,b)=a*b/gcd(a,b);\nlcm(72,30)';run.click();">最小公倍数</a></li>
  </ul>
</div>
<script>
let debg = document.getElementById('debg');
let tree = document.getElementById('tree');
let fileInput = document.getElementById('source_file');
let fileName = document.getElementById('file_name');
let calc = document.getElementById('calc');

tree.style.display = debg.checked ? 'block' : 'none';
debg.onchange = function (){
    tree.style.display = debg.checked ? 'block' : 'none';
}

fileInput.addEventListener('change', async function () {
    const file = this.files && this.files[0];
    if (!file) {
        fileName.textContent = '';
        return;
    }

    fileName.textContent = file.name;

    const text = await file.text();
    calc.value = text;
});
$(function() {
    var guide = `
<ul>
  <li><a href="https://github.com/john-smith-7701/chabo-dsl/blob/main/docs/dslReference_ja.md" target="reference">DSLリファレンス</a></li>
  <li><a href="https://github.com/john-smith-7701/chabo-dsl/blob/main/README_ja.md" target="reference">chabo-dsl ReadMe</a></li>
</ul>
<b>使い方</b><br>
スクリプト欄に計算式を入力し[実行]ボタンをクリックすると計算結果を表示します。<br>
AST表示をONに鶴と計算式の計算ツリーを表示します。<br>
[ファイル選択]ボタンにてローカルに保存したDSLをロードできます。

`;
    $("#sidebar").html(guide);
});
</script>
